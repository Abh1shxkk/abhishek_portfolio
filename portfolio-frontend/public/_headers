# Cloudflare Pages response headers.
# Files in /assets have a content hash in their name, so they never change: cache them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Screenshots and images change rarely; a week in the browser, revalidated after that.
/projects/*.jpg
  Cache-Control: public, max-age=604800
/projects/*.png
  Cache-Control: public, max-age=604800
