{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "redirects": [
    {
      "source": "/",
      "destination": "https://abhishekdev.online/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "destination": "https://abhishekdev.online/:path+",
      "permanent": true
    }
  ]
}
