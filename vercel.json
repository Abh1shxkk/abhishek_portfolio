{
  "installCommand": "npm install --prefix portfolio-frontend",
  "buildCommand": "npm run build --prefix portfolio-frontend",
  "outputDirectory": "portfolio-frontend/dist",
  "framework": null,
  "redirects": [
    {
      "source": "/",
